
points = [(10, 0), (11, 5), (5, 3), (9, 3.5),
          (15, 3), (12.5, 7), (6, 6.5), (7.5, 4.5)]

hull = set()
n = len(points)

for i in range(n):
    for j in range(i + 1, n):
        a, b = points[i], points[j]
        cross = []

        for k in range(n):
            if k != i and k != j:
                c = points[k]
                value = ((b[0]-a[0])*(c[1]-a[1]) -
                         (b[1]-a[1])*(c[0]-a[0]))
                cross.append(value)

        if all(x >= 0 for x in cross) or all(x <= 0 for x in cross):
            hull.add(a)
            hull.add(b)

print("Convex Hull:", list(hull))
