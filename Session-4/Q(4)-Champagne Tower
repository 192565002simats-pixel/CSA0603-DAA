poured = int(input("Enter poured cups: "))
query_row = int(input("Enter query row: "))
query_glass = int(input("Enter query glass: "))

dp = [[0.0] * 101 for i in range(101)]
dp[0][0] = poured

for i in range(query_row):
    for j in range(i + 1):
        if dp[i][j] > 1:
            extra = (dp[i][j] - 1) / 2
            dp[i+1][j] += extra
            dp[i+1][j+1] += extra

print(min(1.0, dp[query_row][query_glass]))
